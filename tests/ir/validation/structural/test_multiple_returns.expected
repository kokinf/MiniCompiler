function abs: int (int x)
  ; Locals:
  ;   x: int (offset 8, size 4)

entry:
  %t1 = ALLOCA 4  ; param x: int
  STORE [%t1], x
  %t2 = LOAD [%t1]
  %t3 = CMP_LT %t2, 0
  JUMP_IF %t3, if_then_1
  JUMP if_merge_2

if_then_1:
  ; preds: entry
  ; idom: entry
  %t4 = LOAD [%t1]
  %t5 = NEG %t4
  RETURN %t5

if_merge_2:
  ; preds: entry
  ; idom: entry
  %t6 = LOAD [%t1]
  RETURN %t6

function main: int ()

entry:
  PARAM 0, -10
  %t1 = CALL abs(-10)
  RETURN %t1
