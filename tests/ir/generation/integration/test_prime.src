fn isPrime(int n) -> bool {
    if (n <= 1) {
        return false;
    }
    int i = 2;
    while (i * i <= n) {
        if (n % i == 0) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn main() -> int {
    if (isPrime(17)) {
        return 1;
    }
    return 0;
}
