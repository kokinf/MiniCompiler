function gcd: int (int a, int b)
  ; Locals:
  ;   a: int (offset 8, size 4)
  ;   b: int (offset 16, size 4)
  ;   temp: int (offset 16, size 4)

entry:
  %t1 = ALLOCA 4  ; param a: int
  STORE [%t1], a
  %t2 = ALLOCA 4  ; param b: int
  STORE [%t2], b
  JUMP while_header_1

while_header_1:
  ; preds: entry, while_body_2
  %t3 = LOAD [%t2]
  %t4 = CMP_NE %t3, 0
  JUMP_IF %t4, while_body_2
  JUMP while_exit_3

while_body_2:
  %t5 = ALLOCA 4  ; var temp: int
  %t6 = LOAD [%t2]
  STORE [%t5], %t6
  %t7 = LOAD [%t1]
  %t8 = LOAD [%t2]
  %t9 = MOD %t7, %t8
  STORE [%t2], %t9
  %t10 = LOAD [%t5]
  STORE [%t1], %t10
  JUMP while_header_1

while_exit_3:
  %t11 = LOAD [%t1]
  RETURN %t11

function main: int ()

entry:
  PARAM 0, 48
  PARAM 1, 18
  %t1 = CALL gcd(48, 18)
  RETURN %t1
