function gcd: int (int a, int b)
  ; Locals:
  ;   a: int (offset 8, size 4)
  ;   b: int (offset 16, size 4)
  ;   temp: int (offset 16, size 4)

entry:
  JUMP while_header_1

while_header_1:
  ; preds: entry, while_body_2
  %t1 = CMP_NE b, 0
  JUMP_IF %t1, while_body_2
  JUMP while_exit_3

while_body_2:
  %t2 = ALLOCA 4  ; var temp: int
  STORE [%t2], b
  %t3 = MOD a, b
  STORE [b], %t3
  %t4 = LOAD [%t2]
  STORE [a], %t4
  JUMP while_header_1

while_exit_3:
  RETURN a

function main: int ()

entry:
  PARAM 0, 48
  PARAM 1, 18
  %t1 = CALL gcd(48, 18)
  RETURN %t1
