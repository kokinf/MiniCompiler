function fib: int (int n)
  ; Locals:
  ;   n: int (offset 8, size 4)

entry:
  %t1 = CMP_LE n, 1
  JUMP_IF %t1, if_then_1
  JUMP if_merge_2

if_then_1:
  RETURN n

if_merge_2:
  %t2 = SUB n, 1
  PARAM 0, %t2
  %t3 = CALL fib(%t2)
  %t4 = SUB n, 2
  PARAM 0, %t4
  %t5 = CALL fib(%t4)
  %t6 = ADD %t3, %t5
  RETURN %t6

function main: int ()

entry:
  PARAM 0, 10
  %t1 = CALL fib(10)
  RETURN %t1
