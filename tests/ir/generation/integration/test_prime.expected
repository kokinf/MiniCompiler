function isPrime: bool (int n)
  ; Locals:
  ;   i: int (offset 8, size 4)
  ;   n: int (offset 8, size 4)

entry:
  %t1 = CMP_LE n, 1
  JUMP_IF %t1, if_then_1
  JUMP if_merge_2

if_then_1:
  RETURN false

if_merge_2:
  %t2 = ALLOCA 4  ; var i: int
  STORE [%t2], 2
  JUMP while_header_3

while_header_3:
  ; preds: if_merge_2, if_merge_7
  %t3 = LOAD [%t2]
  %t4 = LOAD [%t2]
  %t5 = MUL %t3, %t4
  %t6 = CMP_LE %t5, n
  JUMP_IF %t6, while_body_4
  JUMP while_exit_5

while_body_4:
  %t7 = LOAD [%t2]
  %t8 = MOD n, %t7
  %t9 = CMP_EQ %t8, 0
  JUMP_IF %t9, if_then_6
  JUMP if_merge_7

while_exit_5:
  RETURN true

if_then_6:
  RETURN false

if_merge_7:
  %t10 = LOAD [%t2]
  %t11 = ADD %t10, 1
  STORE [%t2], %t11
  JUMP while_header_3

function main: int ()

entry:
  PARAM 0, 17
  %t1 = CALL isPrime(17)
  JUMP_IF %t1, if_then_1
  JUMP if_merge_2

if_then_1:
  RETURN 1

if_merge_2:
  RETURN 0
