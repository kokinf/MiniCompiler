function factorial: int (int n)
  ; Locals:
  ;   n: int (offset 8, size 4)

entry:
  %t1 = ALLOCA 4  ; param n: int
  STORE [%t1], n
  %t2 = LOAD [%t1]
  %t3 = CMP_LE %t2, 1
  JUMP_IF %t3, if_then_1
  JUMP if_merge_2

if_then_1:
  RETURN 1

if_merge_2:
  %t4 = LOAD [%t1]
  %t5 = LOAD [%t1]
  %t6 = SUB %t5, 1
  PARAM 0, %t6
  %t7 = CALL factorial(%t6)
  %t8 = MUL %t4, %t7
  RETURN %t8

function main: int ()
  ; Locals:
  ;   result: int (offset 0, size 4)

entry:
  %t1 = ALLOCA 4  ; var result: int
  PARAM 0, 5
  %t2 = CALL factorial(5)
  STORE [%t1], %t2
  %t3 = LOAD [%t1]
  RETURN %t3
