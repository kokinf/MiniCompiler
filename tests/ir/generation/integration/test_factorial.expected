function factorial: int (int n)
  ; Locals:
  ;   n: int (offset 8, size 4)

entry:
  %t1 = CMP_LE n, 1
  JUMP_IF %t1, if_then_1
  JUMP if_merge_2

if_then_1:
  RETURN 1

if_merge_2:
  %t2 = SUB n, 1
  PARAM 0, %t2
  %t3 = CALL factorial(%t2)
  %t4 = MUL n, %t3
  RETURN %t4

function main: int ()
  ; Locals:
  ;   result: int (offset 0, size 4)

entry:
  %t1 = ALLOCA 4  ; var result: int
  PARAM 0, 5
  %t2 = CALL factorial(5)
  STORE [%t1], %t2
  %t3 = LOAD [%t1]
  RETURN %t3
