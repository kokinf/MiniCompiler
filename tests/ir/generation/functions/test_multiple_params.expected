function sum: int (int a, int b, int c, int d)
  ; Locals:
  ;   a: int (offset 8, size 4)
  ;   b: int (offset 16, size 4)
  ;   c: int (offset 24, size 4)
  ;   d: int (offset 32, size 4)

entry:
  %t1 = ALLOCA 4  ; param a: int
  STORE [%t1], a
  %t2 = ALLOCA 4  ; param b: int
  STORE [%t2], b
  %t3 = ALLOCA 4  ; param c: int
  STORE [%t3], c
  %t4 = ALLOCA 4  ; param d: int
  STORE [%t4], d
  %t5 = LOAD [%t1]
  %t6 = LOAD [%t2]
  %t7 = ADD %t5, %t6
  %t8 = LOAD [%t3]
  %t9 = ADD %t7, %t8
  %t10 = LOAD [%t4]
  %t11 = ADD %t9, %t10
  RETURN %t11

function main: int ()

entry:
  PARAM 0, 1
  PARAM 1, 2
  PARAM 2, 3
  PARAM 3, 4
  %t1 = CALL sum(1, 2, 3, 4)
  RETURN %t1
