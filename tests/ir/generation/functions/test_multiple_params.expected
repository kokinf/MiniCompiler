function sum: int (int a, int b, int c, int d)
  ; Locals:
  ;   a: int (offset 8, size 4)
  ;   b: int (offset 16, size 4)
  ;   c: int (offset 24, size 4)
  ;   d: int (offset 32, size 4)

entry:
  %t1 = ADD a, b
  %t2 = ADD %t1, c
  %t3 = ADD %t2, d
  RETURN %t3

function main: int ()

entry:
  PARAM 0, 1
  PARAM 1, 2
  PARAM 2, 3
  PARAM 3, 4
  %t1 = CALL sum(1, 2, 3, 4)
  RETURN %t1
