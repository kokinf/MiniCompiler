function add: int (int a, int b)
  ; Locals:
  ;   a: int (offset 8, size 4)
  ;   b: int (offset 16, size 4)

entry:
  %t1 = ADD a, b
  RETURN %t1

function main: int ()
  ; Locals:
  ;   result: int (offset 0, size 4)

entry:
  %t1 = ALLOCA 4  ; var result: int
  PARAM 0, 10
  PARAM 1, 20
  %t2 = CALL add(10, 20)
  STORE [%t1], %t2
  %t3 = LOAD [%t1]
  RETURN %t3
