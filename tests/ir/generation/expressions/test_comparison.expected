function main: int ()
  ; Locals:
  ;   a: int (offset 0, size 4)
  ;   b: int (offset 8, size 4)
  ;   c: bool (offset 16, size 1)
  ;   d: bool (offset 24, size 1)
  ;   e: bool (offset 32, size 1)
  ;   f: bool (offset 40, size 1)
  ;   g: bool (offset 48, size 1)
  ;   h: bool (offset 56, size 1)

entry:
  %t1 = ALLOCA 4  ; var a: int
  STORE [%t1], 10
  %t2 = ALLOCA 4  ; var b: int
  STORE [%t2], 20
  %t3 = ALLOCA 1  ; var c: bool
  %t4 = LOAD [%t1]
  %t5 = LOAD [%t2]
  %t6 = CMP_LT %t4, %t5
  STORE [%t3], %t6
  %t7 = ALLOCA 1  ; var d: bool
  %t8 = LOAD [%t1]
  %t9 = LOAD [%t2]
  %t10 = CMP_GT %t8, %t9
  STORE [%t7], %t10
  %t11 = ALLOCA 1  ; var e: bool
  %t12 = LOAD [%t1]
  %t13 = LOAD [%t2]
  %t14 = CMP_LE %t12, %t13
  STORE [%t11], %t14
  %t15 = ALLOCA 1  ; var f: bool
  %t16 = LOAD [%t1]
  %t17 = LOAD [%t2]
  %t18 = CMP_GE %t16, %t17
  STORE [%t15], %t18
  %t19 = ALLOCA 1  ; var g: bool
  %t20 = LOAD [%t1]
  %t21 = LOAD [%t2]
  %t22 = CMP_EQ %t20, %t21
  STORE [%t19], %t22
  %t23 = ALLOCA 1  ; var h: bool
  %t24 = LOAD [%t1]
  %t25 = LOAD [%t2]
  %t26 = CMP_NE %t24, %t25
  STORE [%t23], %t26
  %t27 = LOAD [%t3]
  JUMP_IF %t27, if_then_1
  JUMP if_merge_2

if_then_1:
  ; preds: entry
  ; idom: entry
  RETURN 1

if_merge_2:
  ; preds: entry
  ; idom: entry
  RETURN 0
