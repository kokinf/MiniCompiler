function main: int ()
  ; Locals:
  ;   a: int (offset 0, size 4)
  ;   b: float (offset 8, size 8)
  ;   c: bool (offset 16, size 1)
  ;   d: bool (offset 24, size 1)
  ;   e: int (offset 32, size 4)
  ;   f: int (offset 40, size 4)

entry:
  %t1 = ALLOCA 4  ; var a: int
  STORE [%t1], 42
  %t2 = ALLOCA 8  ; var b: float
  STORE [%t2], 3.14
  %t3 = ALLOCA 1  ; var c: bool
  STORE [%t3], true
  %t4 = ALLOCA 1  ; var d: bool
  STORE [%t4], false
  %t5 = ALLOCA 4  ; var e: int
  STORE [%t5], 0
  %t6 = ALLOCA 4  ; var f: int
  STORE [%t6], -100
  %t7 = LOAD [%t1]
  RETURN %t7
