function main: int ()
  ; Locals:
  ;   x: int (offset 0, size 4)
  ;   y: int (offset 8, size 4)

entry:
  %t1 = ALLOCA 4  ; var x: int
  STORE [%t1], 10
  %t2 = ALLOCA 4  ; var y: int
  %t3 = LOAD [%t1]
  %t4 = CMP_GT %t3, 15
  JUMP_IF %t4, if_then_1
  JUMP if_else_2

if_then_1:
  STORE [%t2], 1
  JUMP if_merge_3

if_else_2:
  STORE [%t2], 2
  JUMP if_merge_3

if_merge_3:
  ; preds: if_then_1, if_else_2
  %t5 = LOAD [%t2]
  RETURN %t5
