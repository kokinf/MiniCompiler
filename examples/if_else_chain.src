fn classify_number(x int) -> int {
    int result = 0;
    
    if (x < 0) {
        result = -1;
    } else {
        if (x == 0) {
            result = 0;
        } else {
            if (x < 10) {
                result = 1;
            } else {
                if (x < 100) {
                    result = 2;
                } else {
                    result = 3;
                }
            }
        }
    }
    
    return result;
}

fn main() -> int {
    int r1 = classify_number(-5);
    int r2 = classify_number(0);
    int r3 = classify_number(5);
    int r4 = classify_number(50);
    int r5 = classify_number(200);
    
    return r1 + r2 + r3 + r4 + r5;
}
