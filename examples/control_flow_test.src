fn test_sc_and() -> int {
    int a = 0;
    int b = 5;
    int result = 0;
    
    if (a != 0 && b / a > 2) {
        result = 1;
    } else {
        result = 2;
    }
    
    return result;
}

fn test_sc_or() -> int {
    int a = 10;
    int result = 0;
    
    if (a > 0 || a > 100) {
        result = 1;
    } else {
        result = 2;
    }
    
    return result;
}

fn test_nested_if() -> int {
    int x = 15;
    int result = 0;
    
    if (x > 10) {
        if (x < 20) {
            result = 1;
        } else {
            result = 2;
        }
    } else {
        result = 3;
    }
    
    return result;
}

fn test_while() -> int {
    int i = 0;
    int sum = 0;
    
    while (i < 10) {
        sum = sum + i;
        i = i + 1;
    }
    
    return sum;
}

fn test_for() -> int {
    int result = 0;
    int i = 0;
    
    for (i = 0; i < 5; i = i + 1) {
        result = result + i;
    }
    
    return result;
}

fn main() -> int {
    int r1 = test_sc_and();
    int r2 = test_sc_or();
    int r3 = test_nested_if();
    int r4 = test_while();
    int r5 = test_for();
    
    return r1 + r2 + r3 + r4 + r5;
}
